    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.106.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
